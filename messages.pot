#: templates/pages/learning.html:42
msgid ""
"Ausência total de defesas. Concatenação direta de strings, execução pura "
"de comandos, sessões estáticas."
msgstr ""

#: templates/pages/learning.html:52
msgid "NÍVEL 02"
msgstr ""

#: templates/pages/learning.html:53
msgid "MEDIUM"
msgstr ""

#: templates/pages/learning.html:54
msgid "Mitigação Ingênua (Bypass)"
