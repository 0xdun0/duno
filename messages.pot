#: templates/pages/learning.html:66
msgid "NÍVEL 03"
msgstr ""

#: templates/pages/learning.html:67
msgid "HIGH"
msgstr ""

#: templates/pages/learning.html:68
msgid "Defesa Avançada com Falha Lógica"
