msgstr "REAL PYTHON CODE"

#: templates/pages/learning.html:100
msgid "LOW — Concatenação Direta"
msgstr "LOW — Direct Concatenation"

#: templates/pages/learning.html:106
msgid "MEDIUM — Blacklist Ingênua"
msgstr "MEDIUM — Naive Blacklist"

#: templates/pages/learning.html:113
msgid "HIGH — Cast sem Prepared Statement"
msgstr "HIGH — Cast without Prepared Statement"

