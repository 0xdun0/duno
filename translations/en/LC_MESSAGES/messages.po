msgid "NÍVEL 01"
msgstr "LEVEL 01"

#: templates/pages/learning.html:39
msgid "LOW"
msgstr "LOW"

#: templates/pages/learning.html:40
msgid "Código Vulnerável por Padrão"
msgstr "Vulnerable Code by Default"

